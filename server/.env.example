# Local Express server port
PORT=5000

# MongoDB connection string (local MongoDB or a MongoDB Atlas cluster)
MONGODB_URI=mongodb://127.0.0.1:27017/qr_attendance

# Secret used to sign JWTs - use a long random value in production
JWT_SECRET=super_secret_jwt_random_key_change_in_production_123456

# Comma-separated list of allowed browser origins
CLIENT_URL=http://localhost:5173

# Optional overrides for the seeded teacher account
SEED_TEACHER_NAME=Dr. Alan Turing
SEED_TEACHER_EMAIL=teacher@university.edu
SEED_TEACHER_PASSWORD=TeacherPass123!
